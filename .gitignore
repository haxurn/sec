# Ignore everything by default
*
*/

# Allow specific files and folders
!.gitignore
!README.md
!lessons/
!lessons/**
!labs/
!labs/**
!notes/
!notes/**
!docs/
!docs/**
!labs/**
!notes/**

# Ignore large files
*.apk
*.zip
*.tar
*.tar.gz
*.rar
*.7z
*.bin
*.exe
*.dll
*.so
*.iso
*.img

# Ignore databases
*.db
*.sqlite
*.sqlite3

# Ignore logs
*.log

# Ignore node modules if any
node_modules/

# Ignore build outputs
build/
dist/
out/

# Ignore IDE files
.vscode/
.idea/
*.swp
*.swo

# Ignore OS files
.DS_Store
Thumbs.db